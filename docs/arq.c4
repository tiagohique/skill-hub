// Skills Hub (POC v3): Postgres + camada BlobStore
// Fonte da verdade da arquitetura. Complementa o CLAUDE.md do projeto.

specification {
  element actor {
    notation 'Pessoa ou cliente externo'
    style {
      shape person
      color sky
    }
  }
  element system {
    notation 'Sistema'
    style {
      color indigo
    }
  }
  element container {
    notation 'Contêiner Docker'
    style {
      border dashed
    }
  }
  element component {
    notation 'Componente de código'
  }
  element table {
    notation 'Tabela no PostgreSQL'
    style {
      shape storage
      color green
    }
  }

  tag future
  tag governance
  tag swap_point

  deploymentNode machine {
    notation 'Máquina'
    style {
      color slate
    }
  }
  deploymentNode compose {
    notation 'Docker Compose'
    style {
      color sky
    }
  }
}

model {
  dev = actor 'Desenvolvedor' {
    description 'Entra no portal com usuário e senha, edita o SKILL.md na própria máquina e envia pelo portal, no computador ou no celular (mesma rede local).'
  }

  claude = actor 'Claude Code' {
    description 'Cliente MCP que lê as skills aprovadas.'
    style {
      color green
    }
  }

  hub_system = system 'Skills Hub' {
    description 'Repositório central e versionado de skills, servido por MCP.'

    portal = container 'Portal' {
      technology 'React + Vite + Tailwind CSS (porta 5173)'
      description 'Tema claro e escuro, responsivo. Login, upload do SKILL.md ou .zip, lista com busca e filtros de domínio e status, detalhe e promoção de versões. Fala só com a API REST. Aberto na rede local, protegido por login (POC: admin/admin).'
      style {
        color sky
        shape browser
      }

      shell = component 'Layout e navegação' {
        technology 'React'
        description 'Navbar global com botão de tema e menu do usuário (ícone; Sair ao passar o mouse ou clicar), rodapé com links para Swagger e MCP, menu hambúrguer no celular e rotas por hash.'
        style {
          color sky
        }
      }

      loginPage = component 'Login e tema' {
        technology 'React'
        description 'Tela de login (usuário e senha), sessão por cookie e alternância de tema claro/escuro, guardada no navegador e no banco.'
        style {
          color sky
        }
      }

      skillsList = component 'Lista de skills' {
        technology 'React'
        description 'Tabela no desktop e cards no celular, com coluna de descrição, busca por nome e filtros de domínio e status (no cliente).'
        style {
          color sky
        }
      }

      uploadForm = component 'Envio de skill' {
        technology 'React'
        description 'Arrastar e soltar .md ou .zip, versão semver com ajuda de correção e erros reais da API.'
        style {
          color sky
        }
      }

      skillDetail = component 'Detalhe da skill' {
        technology 'React'
        description 'Versões, status, arquivos com hash e botões Promover e Depreciar.'
        style {
          color sky
        }
      }

      apiClient = component 'Cliente da API' {
        technology 'fetch'
        description 'Única saída do portal: chama a API REST em /api. Nunca fala com o MCP nem com o banco.'
        style {
          color sky
        }
      }
    }

    hub = container 'Hub' {
      technology 'Python 3.12 (porta 8000)'
      description 'API REST em /api e servidor MCP em /mcp.'
      style {
        color indigo
      }

      api = component 'FastAPI' {
        technology 'FastAPI'
        description 'Upload, validação e rotas do portal. Adaptador fino, sem regra de negócio.'
        style {
          color indigo
        }
      }

      mcp = component 'Servidor MCP' {
        technology 'SDK oficial mcp (Streamable HTTP)'
        description 'skills/list e skills/get (SEP-2640, registrados à mão no mcp 2.3), resources/read e tools de fallback list_skills e get_skill. Adaptador fino, sem regra de negócio.'
        style {
          color indigo
        }
      }

      docs = component 'Documentação (Swagger e MCP)' {
        technology 'FastAPI + Swagger UI'
        description '/docs, /openapi.json e /mcp-docs, com senha simples (HTTP Basic). Referência gerada do próprio servidor MCP.'
        style {
          color indigo
        }
      }

      auth = component 'AuthService' {
        #governance
        technology 'hashlib.scrypt'
        description 'Login, sessões por cookie (só o SHA-256 do token no banco, logout por revoked_at) e tema por usuário. O MCP não passa por aqui.'
        style {
          color amber
        }
      }

      service = component 'SkillService' {
        #governance
        description 'Regras de negócio: draft, beta, stable. Versão imutável. SHA-256 por arquivo e por pacote. Única porta de entrada para dados e blobs.'
        style {
          color amber
        }
      }

      repositories = component 'Repositories' {
        technology 'SQLAlchemy 2 async (Core)'
        description 'Única camada que fala SQL: catálogo e auditoria. Não faz commit; a transação é do SkillService.'
        style {
          color indigo
        }
      }

      blobStore = component 'BlobStore' {
        #swap_point
        technology 'Interface (Protocol)'
        description 'Ponto de troca. put devolve sha256. get confere o hash. exists.'
        style {
          color amber
          border solid
        }
      }

      pgStore = component 'PostgresBlobStore' {
        description 'Implementação usada na POC. Grava na tabela blobs.'
        style {
          color indigo
        }
      }

      s3Store = component 'S3BlobStore ou AzureBlobStore' {
        #future
        description 'Implementação futura em S3 ou Azure Blob, imutável. Não implementar na POC.'
        style {
          color gray
          border dashed
          opacity 50%
        }
      }
    }

    db = container 'PostgreSQL' {
      technology 'Imagem oficial postgres (porta 5432, volume pgdata)'
      description 'Catálogo e blobs. O usuário da aplicação tem permissões mínimas.'
      style {
        color green
        shape storage
      }

      blobs = table 'Tabela blobs' {
        description 'sha256 (chave) e conteúdo em bytea. Só inserção.'
      }

      accounts = table 'Usuários e sessões' {
        description 'users (admin inicial, senha em scrypt, tema) e auth_sessions. Sem DELETE.'
      }

      catalog = table 'Catálogo' {
        description 'skills, versões, arquivos, canais e auditoria.'
      }
    }
  }

  // Relacionamentos
  dev -> hub_system.portal 'edita e envia SKILL.md ou .zip'
  hub_system.portal.shell -> hub_system.portal.skillsList 'abre'
  hub_system.portal.shell -> hub_system.portal.uploadForm 'abre'
  hub_system.portal.loginPage -> hub_system.portal.apiClient 'login, logout, sessão e tema'
  hub_system.portal.skillsList -> hub_system.portal.skillDetail 'leva ao detalhe'
  hub_system.portal.skillsList -> hub_system.portal.apiClient 'lista skills'
  hub_system.portal.uploadForm -> hub_system.portal.apiClient 'envia o arquivo e a versão'
  hub_system.portal.skillDetail -> hub_system.portal.apiClient 'consulta, promove e deprecia'
  hub_system.portal.apiClient -> hub_system.hub.api 'REST /api'
  claude -> hub_system.hub.mcp 'MCP /mcp (Streamable HTTP)'

  hub_system.hub.api -> hub_system.hub.service 'chama'
  hub_system.hub.mcp -> hub_system.hub.service 'chama'
  hub_system.hub.api -> hub_system.hub.docs 'serve a documentação'
  hub_system.hub.docs -> hub_system.hub.mcp 'lista tools e métodos'
  hub_system.hub.api -> hub_system.hub.auth 'exige sessão nas rotas de skills'
  hub_system.hub.auth -> hub_system.hub.repositories 'usuários e sessões'
  hub_system.hub.service -> hub_system.hub.blobStore 'put e get de conteúdo'
  hub_system.hub.blobStore -> hub_system.hub.pgStore 'implementada por (POC)'
  hub_system.hub.blobStore -> hub_system.hub.s3Store 'implementada por (futuro)' {
    style {
      line dashed
    }
  }
  hub_system.hub.pgStore -> hub_system.db.blobs 'SQL'
  hub_system.hub.service -> hub_system.hub.repositories 'consulta e grava o catálogo'
  hub_system.hub.repositories -> hub_system.db.catalog 'SQL'
  hub_system.hub.repositories -> hub_system.db.accounts 'SQL'
}

deployment {
  machine mac 'Seu Mac' {
    compose stack 'Docker Compose' {
      instanceOf hub_system.portal
      instanceOf hub_system.hub
      instanceOf hub_system.db
    }
  }
}

views {
  view index {
    title 'Visão geral'
    include *
  }

  view containers of hub_system {
    title 'Contêineres da POC'
    include *
  }

  view portal of hub_system.portal {
    title 'Telas do portal'
    include *
    include hub_system.hub.api
  }

  view layers of hub_system.hub {
    title 'Camadas do hub e ponto de troca do BlobStore'
    include *
    include hub_system.db.blobs, hub_system.db.catalog, hub_system.db.accounts
    exclude hub_system.db
  }

  dynamic view upload {
    title 'Fluxo: upload de uma skill'
    dev -> hub_system.portal.uploadForm 'arrasta o SKILL.md ou .zip'
    hub_system.portal.uploadForm -> hub_system.portal.apiClient 'envia arquivo e versão'
    hub_system.portal.apiClient -> hub_system.hub.api 'POST /api/skills/upload'
    hub_system.hub.api -> hub_system.hub.service 'valida e cria a versão como draft'
    hub_system.hub.service -> hub_system.hub.blobStore 'put de cada arquivo'
    hub_system.hub.blobStore -> hub_system.hub.pgStore 'delega'
    hub_system.hub.pgStore -> hub_system.db.blobs 'INSERT por sha256'
    hub_system.hub.service -> hub_system.hub.repositories 'grava versão, arquivos e auditoria'
    hub_system.hub.repositories -> hub_system.db.catalog 'INSERT'
  }

  dynamic view login {
    title 'Fluxo: login no portal'
    dev -> hub_system.portal.loginPage 'informa usuário e senha'
    hub_system.portal.loginPage -> hub_system.portal.apiClient 'POST /api/auth/login'
    hub_system.portal.apiClient -> hub_system.hub.api 'envia as credenciais'
    hub_system.hub.api -> hub_system.hub.auth 'confere a senha (scrypt)'
    hub_system.hub.auth -> hub_system.hub.repositories 'grava a sessão'
    hub_system.hub.repositories -> hub_system.db.accounts 'INSERT em auth_sessions'
  }

  dynamic view consume {
    title 'Fluxo: Claude Code lê uma skill stable'
    claude -> hub_system.hub.mcp 'skills/list e skills/get'
    hub_system.hub.mcp -> hub_system.hub.service 'busca versão stable'
    hub_system.hub.service -> hub_system.hub.repositories 'lê versão e hashes'
    hub_system.hub.repositories -> hub_system.db.catalog 'SELECT'
    hub_system.hub.service -> hub_system.hub.blobStore 'get de cada arquivo'
    hub_system.hub.blobStore -> hub_system.hub.pgStore 'delega'
    hub_system.hub.pgStore -> hub_system.db.blobs 'SELECT e confere o hash'
    hub_system.hub.mcp -> claude 'resources/read com digests'
  }

  deployment view local {
    title 'Implantação local (Docker Compose no Mac)'
    include mac, mac.stack, mac.stack.*
  }
}
