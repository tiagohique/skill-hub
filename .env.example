# Skills Hub (POC): variáveis de ambiente. Copie para .env (ignorado pelo git).
# Só valores de desenvolvimento local. Nenhum segredo real aqui.

# PostgreSQL: dono do esquema (roda as migrações) e banco principal
POSTGRES_USER=hub_owner
POSTGRES_PASSWORD=hub_owner_dev
POSTGRES_DB=skillshub

# Usuário da aplicação, com permissões mínimas (sem DELETE, sem UPDATE em blobs)
APP_DB_USER=hub_app
APP_DB_PASSWORD=hub_app_dev

# URLs do hub (o host "postgres" é o nome do serviço no Compose)
DATABASE_URL=postgresql+asyncpg://hub_app:hub_app_dev@postgres:5432/skillshub
MIGRATION_DATABASE_URL=postgresql+asyncpg://hub_owner:hub_owner_dev@postgres:5432/skillshub

# Backend de blobs (POC: postgres)
BLOB_BACKEND=postgres

# Limites de upload
MAX_FILE_BYTES=1048576
MAX_BUNDLE_BYTES=5242880
MAX_FILES=100

# Senha do Swagger (/docs) e da página do MCP (/mcp-docs). Só para ambiente local.
DOCS_PASSWORD=B3123
